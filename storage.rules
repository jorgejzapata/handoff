rules_version = '2';

// Handoff Storage rules. Anything not matched below is denied.
service firebase.storage {
  match /b/{bucket}/o {

    // Resized JPEGs only (the app resizes before upload), under 3 MB.
    function isPhotoUpload() {
      return request.resource.contentType == 'image/jpeg'
        && request.resource.size < 3 * 1024 * 1024;
    }

    // Listing photos: listing-photos/{uid}/{listingId}/{file}.
    // Only the owner writes. Anyone can view a photo by its exact URL (listings
    // are public), but nobody can list a folder.
    match /listing-photos/{uid}/{listingId}/{file} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid && isPhotoUpload();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Chat attachments: chat-attachments/{uid}/{conversationId}/{file}.
    // Verified students write into their own folder: resized JPEGs up to 5 MB
    // or PDFs up to 10 MB. Only the uploader reads through the SDK; the other
    // person opens it from the link inside the message, which only the two of
    // them can read (Firestore rules).
    match /chat-attachments/{uid}/{conversationId}/{file} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && ((request.resource.contentType == 'image/jpeg' && request.resource.size < 5 * 1024 * 1024)
          || (request.resource.contentType == 'application/pdf' && request.resource.size < 10 * 1024 * 1024));
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Profile photos: avatars/{uid}.jpg, signed-up (not anonymous) students only.
    match /avatars/{file} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && file == request.auth.uid + '.jpg'
        && isPhotoUpload();
      allow delete: if request.auth != null && file == request.auth.uid + '.jpg';
    }
  }
}
