rules_version = '2';

// Handoff Firestore rules. Anything not matched below is denied.
// Cloud Functions use the Admin SDK and are not affected by these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A verified CSU email: colostate.edu or rams.colostate.edu.
    // Used by listings and messages once those collections exist.
    // A verified CSU email whose account isn't suspended.
    function isVerifiedCsu() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@(rams[.])?colostate[.]edu')
        && !exists(/databases/$(database)/documents/suspensions/$(request.auth.uid));
    }

    // Admins: an admins/{uid} doc (added in the Firebase console) or an
    // admin custom claim. Nobody can make themselves an admin from the app.
    function isAdmin() {
      return signedIn()
        && (request.auth.token.get('admin', false) == true
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isShortString(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // ---- users/{uid} ----
    // Private to its owner for now: it holds the email. Public profile fields
    // (first name, photo, year) get exposed separately when listings need them.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['firstName', 'email', 'schoolId', 'onboardingStep', 'createdAt', 'lastActiveAt'])
        && request.resource.data.keys().hasAll(['firstName', 'email', 'schoolId', 'createdAt'])
        && isShortString(request.resource.data.firstName, 1, 40)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.schoolId == 'csu'
        && request.resource.data.createdAt == request.time
        && (!('lastActiveAt' in request.resource.data) || request.resource.data.lastActiveAt == request.time)
        && (!('onboardingStep' in request.resource.data) || isShortString(request.resource.data.onboardingStep, 1, 20));

      // Owners can edit profile fields only. email, schoolId, createdAt and
      // status (set by Cloud Functions on suspension) are off limits.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['firstName', 'photoUrl', 'gradYear', 'bio', 'gender', 'genderSelfDescribe',
              'notificationPrefs', 'onboardingStep', 'lastActiveAt'])
        && (!('notificationPrefs' in request.resource.data)
            || (request.resource.data.notificationPrefs is map
              && request.resource.data.notificationPrefs.keys().hasOnly(['email'])
              && request.resource.data.notificationPrefs.get('email', true) is bool))
        && (!('gender' in request.resource.data)
            || request.resource.data.gender in ['woman', 'man', 'nonbinary', 'self'])
        && (!('genderSelfDescribe' in request.resource.data)
            || isShortString(request.resource.data.genderSelfDescribe, 1, 30))
        && (!('firstName' in request.resource.data) || isShortString(request.resource.data.firstName, 1, 40))
        && (!('bio' in request.resource.data) || isShortString(request.resource.data.bio, 0, 140))
        && (!('photoUrl' in request.resource.data) || isShortString(request.resource.data.photoUrl, 1, 1000))
        && (!('gradYear' in request.resource.data) || request.resource.data.gradYear is string);

      // Self-serve account deletion (Account settings).
      allow delete: if isOwner(uid);
    }

    // ---- listings/{listingId} ----
    // Drafts are written by their owner, including anonymous accounts (so a
    // draft saves before signup). Going live needs a verified CSU email and
    // every required field. Boost fields, counts, reportCount and the
    // hidden/removed statuses belong to Cloud Functions.

    function listingContentKeys() {
      return ['listingType', 'roomType', 'bedrooms', 'bathrooms', 'privateBath', 'roommateCount',
        'householdGenders', 'openTo', 'furnished', 'rentCents', 'utilitiesIncluded', 'utilitiesEstimateCents', 'depositNote',
        'availableFrom', 'availableTo', 'datesFlexible', 'neighborhood', 'approxLat', 'approxLng',
        'distanceToCampusMi', 'amenities', 'title', 'description', 'photos', 'landlordStatus',
        'leaseAckAt', 'listerFirstName', 'listerPhotoUrl', 'listerYear', 'listerSince'];
    }

    // Who lives there / who can move in. Roommate preferences are only for
    // rooms in a shared place, never a whole-unit takeover.
    function validGroups(d, groups) {
      return groups is list
        && groups.size() <= 3
        && groups.hasOnly(['women', 'men', 'nonbinary'])
        && (groups.size() == 0 || d.get('listingType', 'room') == 'room');
    }

    function validListingContent(d) {
      return (!('listingType' in d) || d.listingType in ['room', 'takeover'])
        && (!('roomType' in d) || d.roomType in ['private', 'shared', 'whole'])
        && (!('bedrooms' in d) || (d.bedrooms is int && d.bedrooms >= 0 && d.bedrooms <= 10))
        && (!('bathrooms' in d) || (d.bathrooms is number && d.bathrooms >= 0 && d.bathrooms <= 10))
        && (!('privateBath' in d) || d.privateBath is bool)
        && (!('roommateCount' in d) || (d.roommateCount is int && d.roommateCount >= 0 && d.roommateCount <= 10))
        && (!('householdGenders' in d) || validGroups(d, d.householdGenders))
        && (!('openTo' in d) || validGroups(d, d.openTo))
        && (!('furnished' in d) || d.furnished is bool)
        && (!('rentCents' in d) || (d.rentCents is int && d.rentCents >= 10000 && d.rentCents <= 500000))
        && (!('utilitiesIncluded' in d) || d.utilitiesIncluded is bool)
        && (!('utilitiesEstimateCents' in d) || d.utilitiesEstimateCents == null
            || (d.utilitiesEstimateCents is int && d.utilitiesEstimateCents >= 0 && d.utilitiesEstimateCents <= 100000))
        && (!('depositNote' in d) || isShortString(d.depositNote, 0, 120))
        && (!('availableFrom' in d) || d.availableFrom is timestamp)
        && (!('availableTo' in d) || d.availableTo is timestamp)
        && (!('datesFlexible' in d) || d.datesFlexible is bool)
        && (!('neighborhood' in d) || isShortString(d.neighborhood, 0, 60))
        && (!('approxLat' in d) || d.approxLat is number)
        && (!('approxLng' in d) || d.approxLng is number)
        && (!('distanceToCampusMi' in d) || (d.distanceToCampusMi is number && d.distanceToCampusMi >= 0 && d.distanceToCampusMi <= 100))
        && (!('amenities' in d) || (d.amenities is list && d.amenities.size() <= 20))
        && (!('title' in d) || isShortString(d.title, 0, 60))
        && (!('description' in d) || isShortString(d.description, 0, 1000))
        && (!('photos' in d) || (d.photos is list && d.photos.size() <= 8))
        && (!('landlordStatus' in d) || d.landlordStatus in ['allowed', 'needsApproval', 'notSure'])
        && (!('leaseAckAt' in d) || d.leaseAckAt == null || d.leaseAckAt is timestamp)
        && (!('listerFirstName' in d) || isShortString(d.listerFirstName, 1, 40))
        && (!('listerPhotoUrl' in d) || d.listerPhotoUrl == null || isShortString(d.listerPhotoUrl, 1, 1000))
        && (!('listerYear' in d) || d.listerYear == null || isShortString(d.listerYear, 1, 20))
        && (!('listerSince' in d) || isShortString(d.listerSince, 1, 20));
    }

    // Everything a seeker needs before a listing can go live.
    function publishable(d) {
      return d.keys().hasAll(['listingType', 'rentCents', 'availableFrom', 'availableTo', 'title',
          'description', 'photos', 'approxLat', 'approxLng', 'neighborhood', 'landlordStatus',
          'leaseAckAt', 'listerFirstName', 'listerSince'])
        && d.availableTo > d.availableFrom
        && d.title.size() >= 1
        && d.description.size() >= 50
        && d.photos.size() >= 1
        && d.leaseAckAt is timestamp;
    }

    // Move-out date or 3 months (90 days) out, whichever is sooner; never more than 92 days.
    function validExpiry(d) {
      return d.expiresAt is timestamp
        && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(92, 'd');
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /listings/{listingId} {
      allow get, list: if resource.data.status == 'active'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      // Moderation: admins hide, remove or restore a listing. Nothing else.
      allow update: if isAdmin()
        && changed().hasOnly(['status', 'updatedAt', 'moderatedBy', 'moderatedAt', 'moderationReason'])
        && request.resource.data.status in ['hidden', 'removed', 'active']
        && (request.resource.data.status != 'active' || resource.data.status == 'hidden')
        && request.resource.data.moderatedBy == request.auth.uid
        && request.resource.data.moderatedAt == request.time
        && isShortString(request.resource.data.moderationReason, 1, 300);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.schoolId == 'csu'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly(
             listingContentKeys().concat(['ownerId', 'schoolId', 'status', 'createdAt', 'updatedAt']))
        && validListingContent(request.resource.data);

      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && changed().hasOnly(listingContentKeys().concat(
             ['updatedAt', 'status', 'publishedAt', 'expiresAt', 'filledAt', 'filledViaHandoff']))
        && request.resource.data.updatedAt == request.time
        && validListingContent(request.resource.data)
        && (
          // Editing a draft
          (resource.data.status == 'draft' && request.resource.data.status == 'draft'
            && !changed().hasAny(['publishedAt', 'expiresAt', 'filledAt', 'filledViaHandoff']))
          // Publishing
          || (resource.data.status == 'draft' && request.resource.data.status == 'active'
            && isVerifiedCsu()
            && publishable(request.resource.data)
            && request.resource.data.publishedAt == request.time
            && validExpiry(request.resource.data)
            && !changed().hasAny(['filledAt', 'filledViaHandoff']))
          // Editing a live listing
          || (resource.data.status == 'active' && request.resource.data.status == 'active'
            && isVerifiedCsu()
            && publishable(request.resource.data)
            && !changed().hasAny(['publishedAt', 'filledAt', 'filledViaHandoff'])
            && (!changed().hasAny(['expiresAt']) || validExpiry(request.resource.data)))
          // Marking filled
          || (resource.data.status == 'active' && request.resource.data.status == 'filled'
            && request.resource.data.filledAt == request.time
            && request.resource.data.filledViaHandoff is bool
            && !changed().hasAny(['publishedAt', 'expiresAt']))
          // Relisting a filled or expired listing
          || (resource.data.status in ['filled', 'expired'] && request.resource.data.status == 'active'
            && isVerifiedCsu()
            && publishable(request.resource.data)
            && request.resource.data.publishedAt == request.time
            && validExpiry(request.resource.data)
            && !changed().hasAny(['filledAt', 'filledViaHandoff']))
          // Taking it down for another reason
          || (resource.data.status == 'active' && request.resource.data.status == 'expired'
            && changed().hasOnly(['status', 'updatedAt']))
        );

      // Hidden or removed listings stay put for moderation.
      allow delete: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status in ['draft', 'active', 'filled', 'expired'];

      // Views: one doc per visitor per day ({yyyymmdd}_{visitorId}). Anyone,
      // even signed out, can record a view of a live listing; nobody can edit
      // one, and only the lister can read them. The lister's own visits don't count.
      match /views/{viewId} {
        function viewedListing() {
          return get(/databases/$(database)/documents/listings/$(listingId)).data;
        }

        allow create: if viewId.matches('[0-9]{8}_[A-Za-z0-9]{8,40}')
          && request.resource.data.keys().hasOnly(['day', 'at'])
          && request.resource.data.day == viewId.split('_')[0]
          && request.resource.data.at == request.time
          && viewedListing().status == 'active'
          && (request.auth == null || request.auth.uid != viewedListing().ownerId);

        allow read: if signedIn() && viewedListing().ownerId == request.auth.uid;
      }

      // Saves: one doc per student who saved it, so the lister sees "6 saves".
      // Written in the same batch as users/{uid}/saved/{listingId}.
      match /saves/{saverId} {
        function savedListing() {
          return get(/databases/$(database)/documents/listings/$(listingId)).data;
        }

        allow create, update: if isOwner(saverId) && isVerifiedCsu()
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && savedListing().status == 'active'
          && savedListing().ownerId != saverId;
        allow delete: if isOwner(saverId);
        allow read: if signedIn() && savedListing().ownerId == request.auth.uid;
      }

      // The exact address. Only the owner ever reads it; it leaves their
      // account only when they share it in a chat.
      match /private/{docId} {
        function ownsListing() {
          return signedIn()
            && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid;
        }

        allow read, delete: if docId == 'location' && ownsListing();
        allow create, update: if docId == 'location' && ownsListing()
          && request.resource.data.keys().hasOnly(['streetAddress', 'unit', 'exactLat', 'exactLng'])
          && isShortString(request.resource.data.streetAddress, 1, 200)
          && isShortString(request.resource.data.unit, 0, 30)
          && request.resource.data.exactLat is number
          && request.resource.data.exactLng is number;
      }
    }

    // ---- users/{uid}/saved/{listingId} ----
    // A student's saved places, with a small snapshot of each so filled or
    // expired places still show in the list. Only they can see it.
    match /users/{uid}/saved/{listingId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isVerifiedCsu()
        && request.resource.data.keys().hasOnly(
             ['savedAt', 'title', 'rentCents', 'thumbUrl', 'availableFrom', 'availableTo', 'neighborhood'])
        && request.resource.data.savedAt == request.time
        && isShortString(request.resource.data.title, 0, 60)
        && request.resource.data.rentCents is int
        && (request.resource.data.thumbUrl == null || isShortString(request.resource.data.thumbUrl, 1, 1000))
        && isShortString(request.resource.data.availableFrom, 0, 10)
        && isShortString(request.resource.data.availableTo, 0, 10)
        && isShortString(request.resource.data.neighborhood, 0, 60);
    }

    // ---- users/{uid}/blocks/{blockedId} ----
    match /users/{uid}/blocks/{blockedId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && blockedId != uid
        && request.resource.data.keys().hasOnly(['createdAt', 'firstName'])
        && request.resource.data.createdAt == request.time
        && (!('firstName' in request.resource.data) || isShortString(request.resource.data.firstName, 1, 40));
    }

    // ---- conversations/{listingId}_{seekerId} ----
    // One thread per seeker and listing. Only verified CSU students can start
    // or write in one. Sending a message is one batch: the message, plus the
    // conversation's lastMessage and the other person's unread count + 1.
    // No Cloud Function needed.

    function otherParticipant() {
      return resource.data.listerId == request.auth.uid ? resource.data.seekerId : resource.data.listerId;
    }

    function onlyMyKeyChanged(field) {
      return request.resource.data[field].diff(resource.data[field]).affectedKeys().hasOnly([request.auth.uid]);
    }

    function validNewConversation(d) {
      let listing = get(/databases/$(database)/documents/listings/$(d.listingId)).data;
      return listing.status == 'active'
        && d.listerId == listing.ownerId
        && d.seekerId == request.auth.uid
        && d.listerId != d.seekerId
        && d.participantIds == [d.listerId, d.seekerId]
        && d.listingTitle == listing.title
        && d.listerFirstName == listing.listerFirstName
        && isShortString(d.seekerFirstName, 1, 40)
        && (d.seekerPhotoUrl == null || isShortString(d.seekerPhotoUrl, 1, 1000))
        && (d.listerPhotoUrl == null || isShortString(d.listerPhotoUrl, 1, 1000))
        && (d.listingThumbUrl == null || isShortString(d.listingThumbUrl, 1, 1000))
        && d.listingRentCents is int
        && d.listingFrom is timestamp
        && d.listingTo is timestamp
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.lastMessage.keys().hasOnly(['text', 'senderId', 'sentAt'])
        && d.lastMessage.senderId == request.auth.uid
        && d.lastMessage.sentAt == request.time
        && isShortString(d.lastMessage.text, 1, 1000)
        && d.unreadCount.keys().hasOnly([d.listerId, d.seekerId])
        && d.unreadCount[d.listerId] == 1
        && d.unreadCount[d.seekerId] == 0
        && d.lastReadAt.keys().hasOnly([d.seekerId])
        && d.lastReadAt[d.seekerId] == request.time
        && d.closedReason == null
        && d.blockedBy == null
        && !exists(/databases/$(database)/documents/users/$(d.listerId)/blocks/$(d.seekerId))
        && !exists(/databases/$(database)/documents/users/$(d.seekerId)/blocks/$(d.listerId));
    }

    match /conversations/{convId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if isVerifiedCsu()
        && request.resource.data.keys().hasOnly(['listingId', 'listerId', 'seekerId', 'participantIds',
             'listingTitle', 'listingThumbUrl', 'listingRentCents', 'listingFrom', 'listingTo',
             'listerFirstName', 'listerPhotoUrl', 'seekerFirstName', 'seekerPhotoUrl', 'lastMessage',
             'unreadCount', 'lastReadAt', 'closedReason', 'blockedBy', 'createdAt', 'updatedAt'])
        && convId == request.resource.data.listingId + '_' + request.auth.uid
        && validNewConversation(request.resource.data);

      allow update: if isVerifiedCsu()
        && request.auth.uid in resource.data.participantIds
        && (
          // Sending a message
          (changed().hasOnly(['lastMessage', 'unreadCount', 'lastReadAt', 'updatedAt'])
            && resource.data.closedReason == null
            && resource.data.blockedBy == null
            && request.resource.data.lastMessage.keys().hasOnly(['text', 'senderId', 'sentAt'])
            && request.resource.data.lastMessage.senderId == request.auth.uid
            && request.resource.data.lastMessage.sentAt == request.time
            && isShortString(request.resource.data.lastMessage.text, 1, 1000)
            && request.resource.data.updatedAt == request.time
            && request.resource.data.unreadCount.keys().hasOnly(resource.data.participantIds)
            && request.resource.data.unreadCount[otherParticipant()]
                 == resource.data.unreadCount.get(otherParticipant(), 0) + 1
            && request.resource.data.unreadCount[request.auth.uid] == 0
            && onlyMyKeyChanged('lastReadAt'))
          // Reading: clear my unread count and mark when I read
          || (changed().hasOnly(['unreadCount', 'lastReadAt'])
            && request.resource.data.unreadCount[request.auth.uid] == 0
            && onlyMyKeyChanged('unreadCount')
            && onlyMyKeyChanged('lastReadAt')
            && request.resource.data.lastReadAt[request.auth.uid] == request.time)
          // Closing: the lister's listing was filled or taken down
          || (request.auth.uid == resource.data.listerId
            && changed().hasOnly(['closedReason'])
            && request.resource.data.closedReason in ['filled', 'expired'])
          // Blocking: either person can close the thread for good
          || (changed().hasOnly(['blockedBy'])
            && resource.data.blockedBy == null
            && request.resource.data.blockedBy == request.auth.uid)
          // Unblocking: only the person who blocked
          || (changed().hasOnly(['blockedBy'])
            && resource.data.blockedBy == request.auth.uid
            && request.resource.data.blockedBy == null)
          // Leaving (account deletion): my name becomes "Former member", my
          // photo goes, and the thread closes
          || (changed().hasOnly(['listerFirstName', 'listerPhotoUrl', 'seekerFirstName', 'seekerPhotoUrl', 'blockedBy'])
            && (resource.data.listerId == request.auth.uid
              ? (!changed().hasAny(['seekerFirstName', 'seekerPhotoUrl'])
                && request.resource.data.listerFirstName == 'Former member'
                && request.resource.data.listerPhotoUrl == null)
              : (!changed().hasAny(['listerFirstName', 'listerPhotoUrl'])
                && request.resource.data.seekerFirstName == 'Former member'
                && request.resource.data.seekerPhotoUrl == null))
            && (request.resource.data.blockedBy == request.auth.uid
              || (resource.data.blockedBy != null && request.resource.data.blockedBy == resource.data.blockedBy)))
        );

      allow delete: if false;

      match /messages/{messageId} {
        function convAfter() {
          return getAfter(/databases/$(database)/documents/conversations/$(convId)).data;
        }

        // A photo (JPEG, resized by the app, up to 5 MB) or a PDF (up to 10 MB),
        // uploaded by the sender into their own folder for this conversation.
        function validAttachment(a, kind) {
          return a is map
            && a.keys().hasOnly(['url', 'path', 'name', 'size', 'contentType', 'width', 'height'])
            && a.keys().hasAll(['url', 'path', 'name', 'size', 'contentType'])
            && isShortString(a.url, 1, 2000)
            && a.path.matches('chat-attachments/' + request.auth.uid + '/' + convId + '/[A-Za-z0-9]+[.](jpg|pdf)')
            && isShortString(a.name, 1, 120)
            && a.size is int && a.size > 0
            && ((kind == 'image' && a.contentType == 'image/jpeg' && a.size <= 5 * 1024 * 1024)
              || (kind == 'file' && a.contentType == 'application/pdf' && a.size <= 10 * 1024 * 1024));
        }

        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;

        allow create: if isVerifiedCsu()
          && request.auth.uid in convAfter().participantIds
          && convAfter().blockedBy == null
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'sentAt', 'type', 'attachment'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.sentAt == request.time
          && isShortString(request.resource.data.text, 0, 1000)
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text.size() >= 1
              && !('attachment' in request.resource.data)
              && convAfter().closedReason == null)
            // A photo or PDF, with an optional caption
            || (request.resource.data.type in ['image', 'file']
              && validAttachment(request.resource.data.attachment, request.resource.data.type)
              && convAfter().closedReason == null)
            // Only the lister can share the exact address
            || (request.resource.data.type == 'address'
              && request.resource.data.text.size() >= 1
              && !('attachment' in request.resource.data)
              && request.auth.uid == convAfter().listerId
              && convAfter().closedReason == null)
            // "Maya marked this place as filled." when a thread closes
            || (request.resource.data.type == 'system'
              && request.resource.data.text.size() >= 1
              && !('attachment' in request.resource.data)
              && request.auth.uid == convAfter().listerId
              && convAfter().closedReason != null)
          );

        allow update, delete: if false;
      }
    }

    // ---- reports/{reportId} ----
    // Students create; only admins (custom claim) read and act on them.
    match /reports/{reportId} {
      allow create: if isVerifiedCsu()
        && request.resource.data.keys().hasOnly(
             ['reporterId', 'targetType', 'targetId', 'reason', 'details', 'status', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['listing', 'user', 'message']
        && isShortString(request.resource.data.targetId, 1, 300)
        && request.resource.data.reason in ['scam', 'money-before-viewing', 'fake', 'unavailable', 'offensive', 'other']
        && isShortString(request.resource.data.details, 0, 500)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'adminNote'])
        && request.resource.data.status in ['open', 'actioned', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && (!('adminNote' in request.resource.data) || isShortString(request.resource.data.adminNote, 0, 500));
    }

    // ---- Admin ----
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // console or Admin SDK only
    }

    // A suspended student can read their own suspension (to see why);
    // admins create and lift them.
    match /suspensions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['reason', 'by', 'at'])
        && isShortString(request.resource.data.reason, 1, 300)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow delete: if isAdmin();
    }

    // Every admin action, with who, when and why. Append-only.
    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['adminId', 'action', 'targetType', 'targetId', 'reason', 'at'])
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.action in ['hide', 'unhide', 'remove', 'suspend', 'unsuspend', 'dismiss', 'resolve']
        && request.resource.data.targetType in ['listing', 'user', 'report']
        && isShortString(request.resource.data.targetId, 1, 300)
        && isShortString(request.resource.data.reason, 1, 300)
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Admin metrics: total views across listings.
    match /{path=**}/views/{viewId} {
      allow read: if isAdmin();
    }
  }
}
